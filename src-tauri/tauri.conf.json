{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trimly",
  "version": "0.1.0",
  "identifier": "com.trimly.app",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/trimly/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Trimly",
        "width": 980,
        "height": 780,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
